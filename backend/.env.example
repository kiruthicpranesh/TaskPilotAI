# Copy this file to .env and fill in your values. Never commit .env to git.

# Neon (or any Postgres) connection string
DATABASE_URL=postgresql://user:password@host/dbname?sslmode=require

# Groq API key — get yours free at https://console.groq.com
GROQ_API_KEY=gsk_...

# Random secret for signing JWTs — generate with: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=your-random-secret-key-here
